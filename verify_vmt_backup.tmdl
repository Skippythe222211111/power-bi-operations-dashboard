table VMT
	lineageTag: 9799dfcd-e0bf-46a3-8b55-f4dd1c5479ab

	column month
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: dd6e0a34-dc87-455a-9392-025797329d48
		summarizeBy: none
		sourceColumn: month

	column state
		dataType: string
		lineageTag: ca0f3d90-c506-4ded-9feb-0e9d6434b794
		summarizeBy: none
		sourceColumn: state

	column region
		dataType: string
		lineageTag: bcdcdcfa-ad0c-40fb-8b55-756cefd4f2b3
		summarizeBy: none
		sourceColumn: region

	column vmt_millions
		dataType: double
		formatString: #,0.0
		lineageTag: d3edfa42-146d-4aa3-a558-325ad813f979
		summarizeBy: sum
		sourceColumn: vmt_millions

	column stations
		dataType: int64
		formatString: #,0
		lineageTag: be2fca4b-6b7b-449a-bc3b-5c4efa2bf317
		summarizeBy: none
		sourceColumn: stations

	measure 'Total VMT' = SUM ( VMT[vmt_millions] )
		formatString: #,0.0
		lineageTag: 904ba1b9-4bd2-454e-aac4-4fc5d8bcc9e2


	measure 'VMT LY' = CALCULATE ( [Total VMT], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: #,0.0
		lineageTag: 16f5ee33-6d68-4914-b082-2f07e6306cd7


	measure 'VMT YoY %' = DIVIDE ( [Total VMT] - [VMT LY], [VMT LY] )
		formatString: 0.0%
		lineageTag: 4ec8e7e7-619f-47a0-9063-7a723e2b742c


	measure 'Avg Monthly VMT' = AVERAGEX ( VALUES ( DimDate[date] ), [Total VMT] )
		formatString: #,0.0
		lineageTag: e5fbbb6b-afa4-4ea7-a909-f8cdf7c7b795


	measure 'States Reporting' = DISTINCTCOUNT ( VMT[state] )
		formatString: #,0
		lineageTag: 39b94a94-f297-460f-89d9-65fa63d927b5


	measure 'VMT Rolling 12M' = CALCULATE ( [Total VMT], DATESINPERIOD ( DimDate[date], MAX ( DimDate[date] ), -12, MONTH ) )
		formatString: #,0.0
		lineageTag: 8939cfc2-2396-4f26-af4e-f02cd0e5df50


	measure 'VMT Seasonality' = DIVIDE ( [Total VMT], CALCULATE ( [Total VMT], ALL ( DimDate ) ) )
		formatString: 0.0%
		lineageTag: fa423200-80cb-49e3-8099-172cd53fecbd


	measure 'VMT Share' = DIVIDE ( [Total VMT], CALCULATE ( [Total VMT], ALLSELECTED ( DimState ) ) )
		formatString: 0.0%
		lineageTag: dd3887f0-40e3-49e1-a242-eeac237eccf2


	measure 'Monitoring Stations' = SUM ( VMT[stations] )
		formatString: #,0
		lineageTag: 6c2e1599-4e31-478f-a0f6-bfd35aff06de

	partition VMT = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataBase, "http") then Web.Contents(DataBase & "/traffic_vmt_monthly.csv") else File.Contents(DataBase & "\traffic_vmt_monthly.csv"),
				    Source = Csv.Document(Raw,[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"month", type date}, {"state", type text}, {"region", type text}, {"vmt_millions", type number}, {"stations", Int64.Type}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
