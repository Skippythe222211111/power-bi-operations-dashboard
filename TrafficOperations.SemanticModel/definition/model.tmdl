model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataBase","VMT","DimDate","DimState"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBIDesktopVersion = 2.157.879.0

annotation PBI_ProTooling = ["DevMode"]

ref table VMT

ref table DimDate

ref table DimState
