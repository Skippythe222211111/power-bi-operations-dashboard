table DimState
	lineageTag: eeaabba9-3745-479d-a059-8ae167ad6a45

	column state
		dataType: string
		lineageTag: e08db4ae-2b73-48b1-b830-4b56d2541199
		summarizeBy: none
		sourceColumn: state

	column region
		dataType: string
		lineageTag: 00aea56a-1628-48e4-8bac-c36680f24881
		summarizeBy: none
		sourceColumn: region

	partition DimState = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataBase, "http") then Web.Contents(DataBase & "/dim_state.csv") else File.Contents(DataBase & "\dim_state.csv"),
				    Source = Csv.Document(Raw,[Delimiter=",", Columns=2, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"state", type text}, {"region", type text}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
