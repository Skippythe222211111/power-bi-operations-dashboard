table DimDate
	lineageTag: 24d4325c-cdc6-4657-853c-e6d0562a2141

	column date
		dataType: dateTime
		formatString: dd.mm.yyyy
		lineageTag: a373c89b-be4c-457e-b1c1-0be826591feb
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		lineageTag: df15ac73-dac2-448d-a125-9cbf7e15068d
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: b82ccde6-15a4-4a15-8f36-f480f0f3eb36
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: 50c951b9-425f-443b-9e2a-4d7702b4c9e6
		summarizeBy: none
		sortByColumn: month_number
		sourceColumn: month_name

	column month_label
		dataType: string
		lineageTag: b2cd693a-1f8a-49c9-94f1-38de26d31b0f
