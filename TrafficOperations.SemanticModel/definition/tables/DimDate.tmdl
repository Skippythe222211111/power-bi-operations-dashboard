table DimDate
	lineageTag: d30d03a1-3534-4875-abd2-874ebaabb557

	column date
		dataType: dateTime
		formatString: dd.mm.yyyy
		lineageTag: db7c6414-94b3-4913-ba59-7c735c508c9e
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		lineageTag: 4ece9b36-7d04-4c3f-8da5-c655c12f4443
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: 121a76e1-15f3-4cc2-abc3-3ef35e82fcb0
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: 4e86388f-76b8-424d-8e9d-a5f0dc2ffb90
		summarizeBy: none
		sortByColumn: month_number
		sourceColumn: month_name

	column month_label
		dataType: string
		lineageTag: 587d75d5-ce2c-4160-ada0-79ec76146991
		summarizeBy: none
		sortByColumn: date
		sourceColumn: month_label

	column quarter
		dataType: string
		lineageTag: cdda71c9-06d5-4c42-aecd-9c50cb64b08a
		summarizeBy: none
		sourceColumn: quarter

	partition DimDate = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataBase, "http") then Web.Contents(DataBase & "/dim_date.csv") else File.Contents(DataBase & "\dim_date.csv"),
				    Source = Csv.Document(Raw,[Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"date", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"month_label", type text}, {"quarter", type text}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
