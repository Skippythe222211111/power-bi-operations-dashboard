table DimDate
	lineageTag: 472e197c-b7e3-4a6c-b99a-7363591b930d

	column date
		dataType: dateTime
		formatString: dd.mm.yyyy
		lineageTag: 9e2b03c6-ac99-4b58-bd7e-58e6e52ea142
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		lineageTag: f8038111-8636-49f9-a90f-f3f59da535e8
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: f65d4591-cbdf-41c8-90d3-5930615721b0
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: 53d1c1d7-7952-4634-8ebd-4bf78e58b66b
		summarizeBy: none
		sortByColumn: month_number
		sourceColumn: month_name

	column month_label
		dataType: string
		lineageTag: 6d98bf80-5624-4543-9718-adecaa3d07a7
		summarizeBy: none
		sortByColumn: date
		sourceColumn: month_label

	column quarter
		dataType: string
		lineageTag: f52a9c24-7493-4026-a5ad-153475a83eeb
		summarizeBy: none
		sourceColumn: quarter

	partition DimDate = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataBase, "http") then Web.Contents(DataBase & "/dim_date.csv") else File.Contents(DataBase & "\dim_date.csv"),
				    Source = Csv.Document(Raw,[Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"date", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"month_label", type text}, {"quarter", type text}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
