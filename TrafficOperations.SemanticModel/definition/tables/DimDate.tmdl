table DimDate
	lineageTag: 92eba572-c542-4758-8a2b-97a106b20ca2

	column date
		dataType: dateTime
		formatString: dd.mm.yyyy
		lineageTag: 3df65978-c86d-434b-95ed-a7eba087b2dc
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		lineageTag: 0ef19767-c256-4373-8721-4f722443c5c0
		summarizeBy: none
		sourceColumn: year

	column month_number
		dataType: int64
		formatString: 0
		lineageTag: 72de64f6-2a8c-43bc-93af-790958c3a580
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		lineageTag: bd9bd448-d14b-4cb9-ba31-d32b5cce2864
		summarizeBy: none
		sortByColumn: month_number
		sourceColumn: month_name

	column month_label
		dataType: string
		lineageTag: a4bcc103-518f-4ed5-abd2-720dc2d3a1d6
		summarizeBy: none
		sortByColumn: date
		sourceColumn: month_label

	column quarter
		dataType: string
		lineageTag: a9f91a66-a481-4592-b72a-81dfe400a893
		summarizeBy: none
		sourceColumn: quarter

	partition DimDate = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataBase, "http") then Web.Contents(DataBase & "/dim_date.csv") else File.Contents(DataBase & "\dim_date.csv"),
				    Source = Csv.Document(Raw,[Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"date", type date}, {"year", Int64.Type}, {"month_number", Int64.Type}, {"month_name", type text}, {"month_label", type text}, {"quarter", type text}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
