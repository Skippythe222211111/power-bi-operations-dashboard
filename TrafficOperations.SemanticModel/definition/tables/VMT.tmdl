table VMT
	lineageTag: 7d699fe6-1279-462d-a213-2dba3bccb6f2

	column month
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: 805e486e-e7ba-4f58-be48-cc98870e3363
		summarizeBy: none
		sourceColumn: month

	column state
		dataType: string
		lineageTag: 0282babf-ac7a-48bb-80aa-33b4468e13eb
		summarizeBy: none
		sourceColumn: state

	column region
		dataType: string
		lineageTag: d4eab2a9-083f-4283-b229-cb87aa026142
		summarizeBy: none
		sourceColumn: region

	column vmt_millions
		dataType: double
		formatString: #,0.0
		lineageTag: 85fda9f3-4596-43a0-b5a4-ea67379bc3e5
		summarizeBy: sum
		sourceColumn: vmt_millions

	column stations
		dataType: int64
		formatString: #,0
		lineageTag: 55ec7df7-4aef-4bb5-9b8d-1b62400e4d0b
		summarizeBy: none
		sourceColumn: stations

	measure 'Total VMT' = SUM ( VMT[vmt_millions] )
		formatString: #,0.0
		lineageTag: 4d5f30e0-7467-4ebb-9218-725c963c2d25


	measure 'VMT L12M' = CALCULATE ( [Total VMT], DATESINPERIOD ( DimDate[date], MAX ( VMT[month] ), -12, MONTH ) )
		formatString: #,0.0
		lineageTag: e14cd031-b614-4b24-b220-af64267d3f3f


	measure 'VMT Prev12M' = CALCULATE ( [Total VMT], DATESINPERIOD ( DimDate[date], MAX ( VMT[month] ), -24, MONTH ) ) - [VMT L12M]
		formatString: #,0.0
		lineageTag: 2efca9f1-168b-4798-bdfa-c0f42e14e6f4


	measure 'VMT YoY %' = DIVIDE ( [VMT L12M] - [VMT Prev12M], [VMT Prev12M] )
		formatString: 0.0%
		lineageTag: 607b903c-4cd9-479d-bd25-fff31c4c338a


	measure 'VMT YoY Month %' = DIVIDE ( [Total VMT] - [VMT LY], [VMT LY] )
		formatString: 0.0%
		lineageTag: e3624882-b195-42d0-9e39-5f84719201da


	measure 'VMT LY' = CALCULATE ( [Total VMT], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: #,0.0
		lineageTag: 4cd32e52-7490-485a-83a5-c8daa68535cd


	measure 'Avg Monthly VMT' = AVERAGEX ( VALUES ( DimDate[date] ), [Total VMT] )
		formatString: #,0.0
		lineageTag: 42e12e2c-6dd1-413a-9623-5b178b6ac7c0


	measure 'States Reporting' = DISTINCTCOUNT ( VMT[state] )
		formatString: #,0
		lineageTag: 25029464-0b3c-4367-9340-6f5bcdad8190


	measure 'VMT Seasonality' = DIVIDE ( [Total VMT], CALCULATE ( [Total VMT], ALL ( DimDate ) ) )
		formatString: 0.0%
		lineageTag: b245c5b6-d6d2-43cb-9593-7158cc154cd1


	measure 'VMT Share' = DIVIDE ( [Total VMT], CALCULATE ( [Total VMT], ALLSELECTED ( DimState ) ) )
		formatString: 0.0%
		lineageTag: fd6117f1-e1d6-4220-9ae7-ae1d96a34d45


	measure 'Monitoring Stations' = SUM ( VMT[stations] )
		formatString: #,0
		lineageTag: ad8f4709-624c-4e0e-9c56-787a8482d07f

	partition VMT = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataBase, "http") then Web.Contents(DataBase & "/traffic_vmt_monthly.csv") else File.Contents(DataBase & "\traffic_vmt_monthly.csv"),
				    Source = Csv.Document(Raw,[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"month", type date}, {"state", type text}, {"region", type text}, {"vmt_millions", type number}, {"stations", Int64.Type}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
