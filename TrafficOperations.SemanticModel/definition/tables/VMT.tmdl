table VMT
	lineageTag: ed3c5bc9-06f6-451a-a9ac-cbc26c3f718a

	column month
		dataType: dateTime
		formatString: yyyy-mm
		lineageTag: 8dde98cd-ae29-4c15-ac76-dd27ac31812b
		summarizeBy: none
		sourceColumn: month

	column state
		dataType: string
		lineageTag: 7d96ed0b-f84a-466b-bf75-31accc3eab12
		summarizeBy: none
		sourceColumn: state

	column region
		dataType: string
		lineageTag: a4301cc9-7b27-4aad-b432-13e9f8f3b03d
		summarizeBy: none
		sourceColumn: region

	column vmt_millions
		dataType: double
		formatString: #,0.0
		lineageTag: 2618dce4-56f9-4bc9-9627-23cc04cb012a
		summarizeBy: sum
		sourceColumn: vmt_millions

	column stations
		dataType: int64
		formatString: #,0
		lineageTag: 4699e84c-19ce-4eea-a330-c3b962eaeda3
		summarizeBy: none
		sourceColumn: stations

	measure 'Total VMT' = SUM ( VMT[vmt_millions] )
		formatString: #,0.0
		lineageTag: b89ff1eb-506b-4eb6-84cb-0ddc4842e9f1


	measure 'VMT L12M' = CALCULATE ( [Total VMT], DATESINPERIOD ( DimDate[date], MAX ( VMT[month] ), -12, MONTH ) )
		formatString: #,0.0
		lineageTag: c25b2e8c-bde4-4927-9de8-756d3abba9b4


	measure 'VMT Prev12M' = CALCULATE ( [Total VMT], DATESINPERIOD ( DimDate[date], MAX ( VMT[month] ), -24, MONTH ) ) - [VMT L12M]
		formatString: #,0.0
		lineageTag: e1056f54-6dae-4145-8c40-e520300af100


	measure 'VMT YoY %' = DIVIDE ( [VMT L12M] - [VMT Prev12M], [VMT Prev12M] )
		formatString: 0.0%
		lineageTag: c5dc9428-31e3-4c0c-8268-8ee8d1915d3d


	measure 'VMT YoY Month %' = DIVIDE ( [Total VMT] - [VMT LY], [VMT LY] )
		formatString: 0.0%
		lineageTag: 2dc062a5-37d5-4412-8adc-def92afc0915


	measure 'VMT LY' = CALCULATE ( [Total VMT], SAMEPERIODLASTYEAR ( DimDate[date] ) )
		formatString: #,0.0
		lineageTag: 44c2688b-3ded-4fe9-99b4-353dfc2f8eaa


	measure 'Avg Monthly VMT' = AVERAGEX ( VALUES ( DimDate[date] ), [Total VMT] )
		formatString: #,0.0
		lineageTag: 60717282-e917-48ad-af87-da55522650ef


	measure 'States Reporting' = DISTINCTCOUNT ( VMT[state] )
		formatString: #,0
		lineageTag: ebac58be-9628-43a9-a7e1-d05006108f12


	measure 'VMT Seasonality' = DIVIDE ( [Total VMT], CALCULATE ( [Total VMT], ALL ( DimDate ) ) )
		formatString: 0.0%
		lineageTag: ca309f8c-eabe-4277-bf4d-bba9939d2474


	measure 'VMT Share' = DIVIDE ( [Total VMT], CALCULATE ( [Total VMT], ALLSELECTED ( DimState ) ) )
		formatString: 0.0%
		lineageTag: b28ef46b-3553-4c7b-92ed-059ee7d8581b


	measure 'Monitoring Stations' = SUM ( VMT[stations] )
		formatString: #,0
		lineageTag: 48e5da9e-92eb-4119-a40d-282aee648936

	partition VMT = m
		mode: import
		source =
				let
				    Raw = if Text.StartsWith(DataBase, "http") then Web.Contents(DataBase & "/traffic_vmt_monthly.csv") else File.Contents(DataBase & "\traffic_vmt_monthly.csv"),
				    Source = Csv.Document(Raw,[Delimiter=",", Columns=5, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted,{{"month", type date}, {"state", type text}, {"region", type text}, {"vmt_millions", type number}, {"stations", Int64.Type}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table
